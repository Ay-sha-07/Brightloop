# Copy this file to .env and fill in your Supabase connection string.
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string → URI

# Use the "URI" connection string (Transaction pooler recommended for apps):
# postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Or the direct connection (port 5432):
# postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres


# Optional: JWT secret for auth cookies (change in production)
# SECRET_KEY=change-me-to-a-long-random-string
